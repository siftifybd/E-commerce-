rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Staff Accounts Collection (Delivery Riders, Moderators, Admins)
    match /staff_accounts/{staffId} {
      allow read, write: if true;
    }

    // Admin Access Management
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Public Promotional Banners
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Products Catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Settings Collection (Site Settings, Delivery Fees, Payment Gateways, Sliders)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Promotional Coupons
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Real-Time Orders Collection (Order placement, Delivery Management & Tracking)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Product Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Real-Time Messenger Chat & Subcollections
    match /chatSessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Real-Time Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Cash Settlements & Logs
    match /cash_settlements/{settlementId} {
      allow read, write: if true;
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Catch-all for any additional subcollections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

